# BuildKit per-Dockerfile ignore. The build context is the fathom checkout (see Dockerfile) —
# whitelist only what the build needs.
*
!mix.exs
!mix.lock
!config
!lib
!priv
!assets
!native
# The release's vm.args template. Omitting it does not fail the build — `mix release` just
# generates a default vm.args — so the VM flags vanish silently. Keep this whitelisted.
!rel
priv/static/assets
native/*/target
