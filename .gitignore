# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# logs/ is a tracked run record (measurement sweeps); its ignore policy — which
# ephemeral output to skip — lives in logs/.gitignore.

# Python virtualenv for the django-libsql validation harness (test/django_validation).
/.venv/

# Python bytecode artifacts.
__pycache__/
*.pyc

# Ignore package tarball (built via "mix hex.build").
fathom-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Local working notes and plans (see AGENTS.md §Workflow) — kept out of the repo.
/tasks/

# Local AI-assistant configuration and permissions.
/.claude/

# Expert-panel audit reports (`/expert-audit`) and their `.progress.md` logs.
#
# THE RULE: these never go in source control. They are a working artifact of a review pass —
# long, model-generated, full of half-verified hypotheses, and superseded the moment the fixes
# land. Committing them put ~26 files and several hundred provisional findings on the public
# repo's face, where a reader cannot tell a confirmed defect from a rejected one.
#
# This is NOT the same thing as `docs/reviews/`, which stays TRACKED: those are the measured
# run reports (benchmarks, chaos runs, density sweeps) that README.md cites as evidence for the
# project's headline numbers. Measured evidence is published; audit working notes are not.
/audits/

# wire_history.jsonl (mix fathom.wire_bench) and tpc_history.jsonl (mix fathom.tpcc) are TRACKED
# canonical baselines, like perf_history.jsonl. Entries are host-specific: the wire gate's
# `--check` compares only same-host rows, and the TPC-C rows are a recorded-only trend. Commit a
# clean-tree (dirty:false) run to update a host's baseline; append freely otherwise.
.gstack/

# Runtime state written by Fathom.Rebalancer.LbApply after a successful nginx reload
# (expert review 2026-08-01 #23) — a content hash, regenerated per reload, machine-local.
deploy/chaos/lb-runtime/*.applied

# Built by mix compile.fathom_udf from native/fathom_udf — a platform-specific
# shared library, never committed.
/priv/sqlite_ext/

# Dialyzer PLTs. Kept in priv/ rather than _build so `rm -rf _build` does not throw away a
# ~10-20 minute build; machine- and OTP-specific, so never committed.
/priv/plts/
